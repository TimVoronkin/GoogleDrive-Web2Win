{
  "manifest_version": 3,
  "name": "GoogleDrive-Web2Win",
  "key": "",
  "author": "TimVoronkin",
  "version": "1.1",
  "description": "Opens Google Drive folders and files on Windows, extends path visibility.",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "storage",
    "identity"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://drive.google.com/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "290530430896-3isv5lll55g6ch2253ick5it7m2hl8vg.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.readonly"]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://drive.google.com/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://drive.google.com/*"],
      "js": ["contentScript.js"],
      "css": ["styles.css"]
    }
  ]
}
